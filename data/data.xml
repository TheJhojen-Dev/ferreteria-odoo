<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Grupo de Dashboard para Ferretería -->
        <record id="spreadsheet_dashboard_group_ferreteria" model="spreadsheet.dashboard.group">
            <field name="name">Ferretería</field>
            <field name="sequence">100</field>
        </record>

        <!-- Dashboard Spreadsheet (Hoja vacía por los momentos) -->
        <record id="spreadsheet_dashboard_ferreteria" model="spreadsheet.dashboard">
            <field name="name">Control de Inventario Ferretería</field>
            <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_ferreteria"/>
            <field name="spreadsheet_binary_data" type="base64" file="inventario_test/data/ferreteria_dashboard.json"/>
            <field name="main_data_model_ids" eval="[(4, ref('inventario_test.model_ferreteria_producto'))]"/>
            <field name="sequence">10</field>
            <field name="is_published">True</field>
        </record>
    </data>

    <!-- Ocultar dashboards por defecto de Logistics (Stock) -->
    <record id="spreadsheet_dashboard_stock.spreadsheet_dashboard_inventory_flow" model="spreadsheet.dashboard">
        <field name="is_published">False</field>
    </record>
    <record id="spreadsheet_dashboard_stock.spreadsheet_dashboard_warehouse_operations" model="spreadsheet.dashboard">
        <field name="is_published">False</field>
    </record>
</odoo>
