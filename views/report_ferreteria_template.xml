<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción de Reporte (Aparece en el menú Imprimir de la vista lista y formulario) -->
    <record id="action_report_ferreteria_inventario" model="ir.actions.report">
        <field name="name">Inventario de Ferretería (PDF)</field>
        <field name="model">ferreteria.producto</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inventario_test.report_ferreteria_inventario_template</field>
        <field name="report_file">inventario_test.report_ferreteria_inventario_template</field>
        <field name="print_report_name">'Inventario_Ferreteria_' + time.strftime('%Y-%m-%d')</field>
        <field name="binding_model_id" ref="model_ferreteria_producto"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Plantilla QWeb del Reporte PDF -->
    <template id="report_ferreteria_inventario_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 13px;">
                    <!-- Encabezado del Reporte -->
                    <div class="row mb-4">
                        <div class="col-8">
                            <h2 style="color: #2C3E50; font-weight: bold; margin-bottom: 5px;">
                                Reporte de Inventario de Ferretería
                            </h2>
                            <p class="text-muted" style="margin: 0;">
                                Control y existencia física de productos
                            </p>
                        </div>
                        <div class="col-4 text-end">
                            <strong>Fecha de emisión:</strong><br/>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>

                    <!-- Tabla de Productos -->
                    <table class="table table-sm table-striped" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #2C3E50; color: white;">
                                <th style="padding: 8px;">Código</th>
                                <th style="padding: 8px;">Descripción</th>
                                <th style="padding: 8px;">Categoría</th>
                                <th class="text-end" style="padding: 8px;">Stock</th>
                                <th class="text-center" style="padding: 8px;">U.M.</th>
                                <th class="text-end" style="padding: 8px;">Costo ($)</th>
                                <th class="text-end" style="padding: 8px;">Venta ($)</th>
                                <th class="text-center" style="padding: 8px;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_stock" t-value="0"/>
                            <t t-set="total_valorizado" t-value="0"/>
                            
                            <tr t-foreach="docs" t-as="p" style="border-bottom: 1px solid #dee2e6;">
                                <td style="padding: 6px; font-weight: bold;">
                                    <span t-field="p.codigo"/>
                                </td>
                                <td style="padding: 6px;">
                                    <span t-field="p.name"/>
                                </td>
                                <td style="padding: 6px;">
                                    <span t-field="p.categoria_id.name"/>
                                </td>
                                <td class="text-end" style="padding: 6px; font-weight: bold;">
                                    <span t-field="p.stock_actual"/>
                                </td>
                                <td class="text-center" style="padding: 6px;">
                                    <span t-field="p.unidad_medida"/>
                                </td>
                                <td class="text-end" style="padding: 6px;">
                                    <span t-field="p.precio_costo" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                </td>
                                <td class="text-end" style="padding: 6px;">
                                    <span t-field="p.precio_venta" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                </td>
                                <td class="text-center" style="padding: 6px;">
                                    <span t-if="p.estado == 'disponible'" class="badge bg-success" style="padding: 4px 8px; border-radius: 4px; color: white;">En Stock</span>
                                    <span t-if="p.estado == 'bajo_stock'" class="badge bg-warning text-dark" style="padding: 4px 8px; border-radius: 4px;">Stock Bajo</span>
                                    <span t-if="p.estado == 'agotado'" class="badge bg-danger" style="padding: 4px 8px; border-radius: 4px; color: white;">Agotado</span>
                                </td>

                                <t t-set="total_stock" t-value="total_stock + p.stock_actual"/>
                                <t t-set="total_valorizado" t-value="total_valorizado + (p.stock_actual * p.precio_costo)"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Resumen / Totales -->
                    <div class="row mt-4" style="page-break-inside: avoid;">
                        <div class="col-6 offset-6">
                            <table class="table table-sm table-bordered">
                                <tr style="background-color: #f8f9fa;">
                                    <th style="padding: 8px;">Total Artículos Listados:</th>
                                    <td class="text-end" style="padding: 8px; font-weight: bold;">
                                        <span t-esc="len(docs)"/>
                                    </td>
                                </tr>
                                <tr style="background-color: #f8f9fa;">
                                    <th style="padding: 8px;">Total Existencias (Unidades):</th>
                                    <td class="text-end" style="padding: 8px; font-weight: bold;">
                                        <span t-esc="'%.2f' % total_stock"/>
                                    </td>
                                </tr>
                                <tr style="background-color: #e9ecef;">
                                    <th style="padding: 8px;">Valor Total Inventario (Costo):</th>
                                    <td class="text-end" style="padding: 8px; font-weight: bold; color: #2C3E50;">
                                        <span t-esc="total_valorizado" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
